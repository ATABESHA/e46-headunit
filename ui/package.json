{
  "name": "@e46/ui",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && E46_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:browser": "vite --port 5173 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "kiosk": "electron . --kiosk"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
